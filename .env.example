# DuriOS Open-Core Configuration Template (.env.example)
# Copy to .env for local configuration. Never commit .env to Git!

# 1. On-Premises Loopback Binding (GATE-03 Security Requirement)
DURIOS_HOST=127.0.0.1
DURIOS_PORT=3000
DURIOS_DB_PATH=./data/durios.db
DURIOS_DATA_DIR=./data/uploads
DURIOS_BACKUP_DIR=./data/backups

# 2. GATE-01 Signed PDPL Consent Path (Luật Bảo vệ dữ liệu cá nhân 91/2025/QH15)
# DURIOS_GATE01_CONSENT_FILE=./data/consent-91-2025-signed.pdf

# 3. GATE-02 OTP Channel (Defaults to fail-closed 503 until configured)
DURIOS_OTP_PROVIDER=UNCONFIGURED
# DURIOS_OTP_API_URL=https://otp.durios.vn/v1/dispatch
# DURIOS_OTP_API_KEY=your-managed-zns-key

# 4. DuriOS Pro SaaS / Enterprise Subscription (Optional — Zero-Reinstall Upgrade)
# When unset, DuriOS runs in free COMMUNITY_OPEN_CORE mode with 100% local access.
# DURIOS_SAAS_LICENSE_KEY=
# DURIOS_UPGRADE_PORTAL_URL=https://cloud.durios.vn/upgrade

# 5. Guarded B2B Marketplace & Non-Custodial Escrow (Prompt 6A — Dual-Locked by Default)
DURIOS_FEATURE_B2B_MARKETPLACE=disabled
