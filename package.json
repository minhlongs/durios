{
  "name": "durios-core",
  "version": "0.1.0",
  "description": "DuriOS Container Dossier Workspace - Local Vertical Slice",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/cli.ts",
    "start:server": "bun run src/server/server.ts",
    "pilot:seed-rehearsal": "bun run src/auth/pilot-rehearsal-seeder.ts",
    "pilot:evaluate-kpi": "bun run src/auth/pilot-kpi-evaluator.ts",
    "pilot:verify-gates": "bun run src/auth/pilot-launch-gate-verifier.ts",
    "pilot:audit-pack": "bun run src/export/field-auditor-cli.ts",
    "pilot:proof-kit": "bun run src/export/field-proof-kit-cli.ts",
    "opc:license": "bun run src/saas/license-generator-cli.ts",
    "blueprint:verify-25-steps": "bun run src/saas/blueprint-cli.ts",
    "verify:manifest": "bun run src/export/standalone-manifest-verifier.ts",
    "saas:sign-license": "bun run src/saas/license-signer-cli.ts"
  },
  "keywords": [
    "durios",
    "durian-export",
    "compliance",
    "container-dossier"
  ],
  "author": "DuriOS Engineering",
  "license": "AGPL-3.0-only OR LicenseRef-DuriOS-Commercial",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
